+/*
+ * GetIcebergManifestProperties returns the manifest key-value metadata
+ * required by the spec for format version 2 as a list of
+ * AvroMetadataProperty.
+ */
+static List *
+GetIcebergManifestProperties(IcebergTableSchema * schema, IcebergPartitionSpec * partitionSpec,
+							 IcebergManifestContentType contentType)
+{
+	if (schema == NULL || partitionSpec == NULL)
+		return NIL;
+
+	StringInfo	schemaJson = makeStringInfo();
+
+	AppendIcebergTableSchema(schemaJson, schema);
+
+	/* only the partition fields array, not the whole spec */
+	StringInfo	partitionSpecJson = makeStringInfo();
+
+	AppendIcebergPartitionSpecFields(partitionSpecJson, partitionSpec->fields,
+									 partitionSpec->fields_length);
+
+	const char *keys[] = {
+		"schema", "schema-id", "partition-spec", "partition-spec-id",
+		"format-version", "content"
+	};
+	const char *values[] = {
+		schemaJson->data,
+		psprintf("%d", schema->schema_id),
+		partitionSpecJson->data,
+		psprintf("%d", partitionSpec->spec_id),
+		/* manifests are always written with manifest_schema_v2 */
+		"2",
+		contentType == ICEBERG_MANIFEST_FILE_CONTENT_DELETES ? "deletes" : "data"
+	};
+
+	List	   *properties = NIL;
+
+	for (int i = 0; i < lengthof(keys); i++)
+	{
+		AvroMetadataProperty *property = palloc0(sizeof(AvroMetadataProperty));
+
+		property->key = keys[i];
+		property->value = values[i];
+
+		properties = lappend(properties, property);
+	}
+
+	return properties;
+}
