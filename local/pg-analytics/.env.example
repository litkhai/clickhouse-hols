# Local-only lab settings. Copy to .env (00-setup.sh does this for you).
# None of these are real credentials: every service runs on a private
# Docker network on your laptop.

# ---- object storage (MinIO) ----
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=warehouse

# ---- Polaris bootstrap (root principal of realm POLARIS) ----
POLARIS_ROOT_ID=root
POLARIS_ROOT_SECRET=polaris-root-secret
# Iceberg warehouse = Polaris catalog name = pg-main database name
# (pg_lake maps database -> warehouse, schema -> namespace)
ILM_DB=ilm

# ---- workload ----
# TPC-H scale factors to run, space separated (1 = smoke, 10 = main)
SF_LIST="1 10"
# rows with o_orderdate / l_shipdate on or after this stay in PG heap
HOT_CUTOFF=1998-02-01
QUERY_TIMEOUT_S=300
WARM_ITERS=5

# ---- resource caps (per-node mode) ----
# Sized for a Docker Desktop VM with 12 vCPU / 8 GB. The design document's
# 4 CPU / 12 GB per engine needs a 48 GB host; see docs/DESIGN.md.
ENGINE_CPUS=4
ENGINE_MEM=4g
PGDUCK_MEMORY_LIMIT=2500MB
PG_SHARED_BUFFERS=1GB
