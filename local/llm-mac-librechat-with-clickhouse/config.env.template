# LibreChat Configuration Template
# Copy this to config.env and fill in your values
# Generated by setup.sh --configure

# LibreChat Settings
LIBRECHAT_PORT=3080

# Secrets. `./setup.sh` generates these for you; to do it by hand:
#   SESSION_SECRET / JWT_SECRET / JWT_REFRESH_SECRET / CREDS_KEY: openssl rand -hex 32
#   CREDS_IV:                                                     openssl rand -hex 16
# CREDS_KEY and CREDS_IV encrypt the provider credentials LibreChat stores, so
# changing them makes previously saved credentials unreadable.
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# Ollama Settings
OLLAMA_BASE_URL=http://host.docker.internal:11434
PRIMARY_MODEL=qwen2.5-coder:3b
SECONDARY_MODEL=

# ClickHouse MCP Server Settings
CH_HOST=localhost
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=default

# MCP Server Port
MCP_SERVER_PORT=3001
