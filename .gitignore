*.DS_Store
.DS_Store
workshop/observability-waf/artifact.md
S3_ClickPipes_Performance_Guide.md

# Secrets — commit only the .example / .template counterparts
.env
.env.local
# ...except this one: it holds lab dimensions (ports, ROWS, partitions), no
# credentials, and _env.sh silently falls back to defaults when it is absent.
!workload/kafka-partitioning-ingestion/.env
*.tfvars
!*.tfvars.example

# Generated by local/oss-mac-setup/set.sh (contains machine-specific paths)
local/oss-mac-setup/docker-compose.yml

# Container runtime state (recreated by each setup script)
local/oss-mac-setup/data/
local/oss-mac-setup/logs/
**/clickhouse-data/
**/clickhouse-logs/

# Terraform working state. A saved plan carries the whole state inside it, so
# ignoring *.tfstate alone is not enough — that is how a tfplan holding real
# account IDs, bucket names and role ARNs got committed here once.
**/.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
# Editor leftovers next to a tfvars file: terraform.tfvars.save is not matched
# by *.tfvars, and two of them were committed as corrupted vim buffers.
*.tfvars.*
!*.tfvars.example

# Local artifacts
*.bak
*.log
**/test-results/
**/backup-*/
**/backup-metadata-*/
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
