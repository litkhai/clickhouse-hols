# MV vs RMV test configuration
# Copy to .env and fill in your own values, then source it before running the scripts:
#   cp .env.example .env && set -a && . ./.env && set +a
# .env is gitignored — never commit real credentials to this public repository.

CH_HOST=<your-service>.<region>.aws.clickhouse.cloud
CH_USER=default
CH_PASSWORD=
CH_DATABASE=mv_vs_rmv
