# =============================================================================
#  실시간 JSON explode 데모 설정 (Confluent Cloud → ClickPipes → ClickHouse Cloud)
#  이 파일을 `.env` 로 복사한 뒤 값을 채우세요.  cp .env.example .env
#  .env 는 .gitignore 로 커밋되지 않습니다. 절대 커밋하지 마세요.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) ClickHouse Cloud — SQL / 데이터 플레인 (테이블·MV 생성, 데모 쿼리)
#    Cloud 콘솔 → 서비스 → "Connect" 에서 확인
# -----------------------------------------------------------------------------
CH_HOST=xxxxxxxx.ap-northeast-2.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=
CH_SECURE=true

# -----------------------------------------------------------------------------
# 2) ClickHouse Cloud — OpenAPI / 컨트롤 플레인 (ClickPipes 자동 생성/삭제)
#    콘솔 → 조직 설정 → API Keys 에서 Key ID / Secret 발급
#    Org ID: 콘솔 URL 또는 조직 설정 / Service ID: 서비스 상세 페이지 URL
# -----------------------------------------------------------------------------
CH_API_KEY_ID=
CH_API_KEY_SECRET=
CH_ORG_ID=
CH_SERVICE_ID=
CH_API_URL=https://api.clickhouse.cloud/v1

# -----------------------------------------------------------------------------
# 3) Confluent Cloud — Kafka 데이터 소스
#    ※ 토픽은 이미 존재한다고 가정합니다(자동 생성하지 않음).
#    Cluster settings → Bootstrap server, API keys 에서 Key/Secret 발급
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP=pkc-xxxxx.ap-northeast-2.aws.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_TOPIC=order-events
KAFKA_SASL_MECHANISM=PLAIN
# 허용값: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512  (Confluent 기본은 PLAIN)

# -----------------------------------------------------------------------------
# 4) 스키마 / 오브젝트 이름 — 모두 여기서 정의 (SQL·ClickPipes 스크립트가 참조)
# -----------------------------------------------------------------------------
CH_DATABASE=analytics
TBL_RAW=orders_raw
TBL_STAGING=orders_staging
TBL_FACT=order_lines_fact
MV_TRANSFORM=orders_transform_mv
MV_EXPLODE=order_lines_mv

# -----------------------------------------------------------------------------
# 5) 데모 동작 파라미터
# -----------------------------------------------------------------------------
LOCAL_TZ=Asia/Seoul
VALID_STATUSES=completed,processing,shipped,delivered
STAGING_TTL_DAYS=7

# ClickPipes
CLICKPIPE_NAME=order-events-explode-demo
CLICKPIPE_OFFSET=from_latest
# 허용값: from_beginning | from_latest
CLICKPIPE_REPLICAS=1

# -----------------------------------------------------------------------------
# 6) 로컬 주문 생성기 (producer) 튜닝
# -----------------------------------------------------------------------------
PRODUCE_RATE=20
# 초당 발행 건수 (0.05s 간격 ≈ 20/s)
PRODUCE_MAX=0
# 총 발행 건수. 0 = Ctrl+C 까지 무한
PLACEHOLDER_RATE=0.15
# customer_id 를 placeholder((not set)/undefined/""/null)로 낼 비율 → NULL 치환 시연
EMPTY_LINES_RATE=0.05
# order_lines 를 빈 배열로 낼 비율 → explode_outer 시연
