# Device360 workshop configuration
# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored — never commit real credentials to this public repository.

# --- ClickHouse Cloud service ---
CLICKHOUSE_HOST=<your-service>.<region>.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=device360

# --- ClickHouse Cloud API (only needed by the scaling tests) ---
# Create these under Organization -> API keys. They are organization-wide: treat them
# like root credentials and scope them to the smallest role that works.
CLICKHOUSE_ORG_ID=
CLICKHOUSE_API_KEY_ID=
CLICKHOUSE_API_KEY_SECRET=
CLICKHOUSE_SERVICE_ID=

# --- S3 source data ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
